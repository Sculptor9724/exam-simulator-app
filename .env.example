# Required, browser-visible Supabase configuration for YOUR local/separate project.
# Copy to .env.local, then get values from `supabase status` after `supabase start`.
REACT_APP_SUPABASE_URL=http://127.0.0.1:54321
REACT_APP_SUPABASE_ANON_KEY=
# Paste the local anon/publishable key above. NEVER use a service_role or secret key.
# The AI backend is separate; this config does not supply AI-provider credentials.

# Required browser-visible URL of YOUR backend. No production fallback.
REACT_APP_API_URL=http://127.0.0.1:3002
